#!/usr/bin/env python3
"""Install the adjacent bundle, link --dev, or explicitly --uninstall it."""

import sys

# Managed bundles must remain exactly the files recorded in their manifest.
sys.dont_write_bytecode = True

if sys.version_info < (3, 11):
    sys.stderr.write("install requires Python 3.11 or newer; install Python 3.11+ and run again.\n")
    raise SystemExit(1)

from pathlib import Path

source = Path(__file__).absolute().parent
sys.path.insert(0, str(source / "src"))

from claude_docker.installer import main

raise SystemExit(main(source))
